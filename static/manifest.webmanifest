		{ "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
	],
	"screenshots": [
		{ "src": "/screenshot.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Gallery of generated images next to the prompt form" },
		{ "src": "/screenshot-narrow.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Gallery of generated images on a phone" }
