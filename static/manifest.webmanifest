{
	"id": "/",
	"name": "GPT Image Generator",
	"short_name": "GPT Images",
	"description": "Generate and edit images, animated GIFs and SVGs in your browser with OpenAI's GPT Image 2, 2.5 and 2.6 models, using your own API key.",
	"lang": "en",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#11111b",
